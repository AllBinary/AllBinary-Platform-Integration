<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.allbinary</groupId>
    <artifactId>AllBinary-Platform-IntegrationPOM</artifactId>
    <packaging>pom</packaging>
    <!-- AllBinary Platform Version Start -->
    <version>1.0.0-SNAPSHOT</version>
    <!-- AllBinary Platform Version End -->

    <name>AllBinary-Platform-IntegrationPOM</name>
    <url>http://www.allbinary.com/</url>
    
    <distributionManagement>
        <snapshotRepository>
            <id>nexus-snapshots</id>
            <name>AllBinary Snapshots Nexus</name>
            <url>https://nexus-allbinary.rhcloud.com/nexus/content/repositories/snapshots/</url>
        </snapshotRepository>
        <repository>
            <id>nexus-releases</id>
            <name>AllBinary Releases Nexus</name>
            <url>https://nexus-allbinary.rhcloud.com/nexus/content/repositories/releases/</url>
        </repository>
    </distributionManagement>

    <properties>
        <buildLabel>${project.version}</buildLabel>
        <assemblyPluginVersion>2.2-beta-1</assemblyPluginVersion>
    </properties>

    <modules>

        <!--
        -->
        <module>./embedded/j2me/antenna</module>
        <module>./graphics/swt/org.eclipse.swt.win32.win32.x86_64-4.4.2_allbinary</module>
        <module>./embedded/j2me/microemulator/3.0.0/microemulator</module>
        
        <module>./embedded/j2me/microemulator/custom/MicroEmulatorCustomUIBaseJavaLibraryM</module>
        <module>./embedded/j2me/microemulator/custom/MicroEmulatorCustomUIJavaLibraryM</module>
        <module>./embedded/j2me/microemulator/custom/MicroEmulatorCustomUIPreJavaLibraryM</module>
        
        <module>./embedded/j2me/microemulator/custom/MicroemulatorSkinJavaLibraryM</module>

        <module>./graphics/opengl/min3d/Min3dBaseJavaLibraryM</module>
        
        <module>./communication/XmlRpc/XmlRpcJavaLibraryM</module>
        <module>./data/json/j2me-json</module>
        <module>./graphics/layer/TiledJSONJavaLibraryM</module>
        
        <module>./embedded/j2me/microemulator/custom/MicroEmulatorCustomGameJavaLibraryM</module>
        
    </modules>

    <dependencies>
        
    </dependencies>

</project>
